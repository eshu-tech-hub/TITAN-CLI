[Unit]
Description=TITAN - Institutional Trading Intelligence System
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=titan
Group=titan
WorkingDirectory=/opt/titan
ExecStart=/opt/titan/.venv/bin/python -m titan status
Restart=on-failure
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=300

Environment=TITAN_ENVIRONMENT=production
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

StandardOutput=journal
StandardError=journal
SyslogIdentifier=titan

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/titan/data /opt/titan/logs
PrivateTmp=yes

MemoryMax=1G
CPUQuota=100%

[Install]
WantedBy=multi-user.target
